{
  "name": "zerokey-proxy",
  "version": "0.5.0",
  "description": "OpenAI-compatible AI proxy for DeepSeek, Claude, ChatGPT, Qwen & Inception — no API keys, real browser sessions",
  "main": "server.js",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write --list-different .",
    "check": "node scripts/check-modules.js",
    "check:prefixes": "node scripts/check-prefix-drift.js",
    "test": "node --test --test-reporter=dot \"test/**/*.test.js\"",
    "precommit": "pnpm format && pnpm lint && pnpm check && pnpm test",
    "postinstall": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "express": "^5.2.1",
    "impit": "^0.14.7",
    "playwright": "^1.63.0",
    "prompts": "^2.4.2",
    "sqlite-pro": "^0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.9",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9"
  }
}
